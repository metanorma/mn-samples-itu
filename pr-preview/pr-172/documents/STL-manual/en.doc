</td><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;page-break-after:auto;"><p style="text-align: left;page-break-after:auto" class="MsoNormal"><a name="_bfc6553d-01e8-1dbe-04aa-d6d0a96e5a59" id="_bfc6553d-01e8-1dbe-04aa-d6d0a96e5a59"></a>MULT()</p>
</td><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;page-break-after:auto;"><p style="text-align: left;page-break-after:auto" class="MsoNormal"><a name="_ba28a87a-9a14-51c3-472e-f9e7d07f9366" id="_ba28a87a-9a14-51c3-472e-f9e7d07f9366"></a>a=b*c</p>
</td><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;page-break-after:auto;"><p style="text-align: left;page-break-after:auto" class="MsoNormal"><a name="_40be3f94-43d2-526e-bb2f-469c80e7c340" id="_40be3f94-43d2-526e-bb2f-469c80e7c340"></a>1</p>

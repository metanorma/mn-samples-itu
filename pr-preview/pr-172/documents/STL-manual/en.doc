</td><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;page-break-after:auto;"><p style="text-align: left;page-break-after:auto" class="MsoNormal"><a name="_d8852426-12e8-a055-ae8d-6c38b50fbfba" id="_d8852426-12e8-a055-ae8d-6c38b50fbfba"></a>MAC()</p>
</td><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;page-break-after:auto;"><p style="text-align: left;page-break-after:auto" class="MsoNormal"><a name="_652e9a08-5791-6816-bef9-cfacd6466200" id="_652e9a08-5791-6816-bef9-cfacd6466200"></a>a+=b*c</p>
</td><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;page-break-after:auto;"><p style="text-align: left;page-break-after:auto" class="MsoNormal"><a name="_513d879d-c591-a622-9dbc-e248612bd410" id="_513d879d-c591-a622-9dbc-e248612bd410"></a>1</p>
</td><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;page-break-after:auto;"><p style="text-align: left;page-break-after:auto" class="MsoNormal"><a name="_8f443bc6-089d-1eaa-9995-718ef9ff5e90" id="_8f443bc6-089d-1eaa-9995-718ef9ff5e90"></a>1</p>
</td></tr><tr><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;page-break-after:auto;"><p style="text-align: left;page-break-after:auto" class="MsoNormal"><a name="_6b889053-d598-85b3-c6e0-c7bc84f37002" id="_6b889053-d598-85b3-c6e0-c7bc84f37002"></a>Move</p>
</td><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;page-break-after:auto;"><p style="text-align: left;page-break-after:auto" class="MsoNormal"><a name="_a07d178b-fca4-25c0-3e95-cb85c5ea5f57" id="_a07d178b-fca4-25c0-3e95-cb85c5ea5f57"></a>MOVE()</p>
</td><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;page-break-after:auto;"><p style="text-align: left;page-break-after:auto" class="MsoNormal"><a name="_c180ec21-3ce2-6241-f42f-857178ba5aec" id="_c180ec21-3ce2-6241-f42f-857178ba5aec"></a>a=b, a[i]=b[i] ONLY<br/> assignment or copy</p>
</td><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;page-break-after:auto;"><p style="text-align: left;page-break-after:auto" class="MsoNormal"><a name="_9e2cb850-96a7-8763-f467-1fe315462930" id="_9e2cb850-96a7-8763-f467-1fe315462930"></a>1</p>
